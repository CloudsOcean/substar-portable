{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://substar.local/schemas/worker-command.v2.json",
  "title": "Substar worker command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "attempt",
    "task_type",
    "input_schema",
    "input",
    "paths",
    "credential_refs"
  ],
  "properties": {
    "schema_version": { "const": "substar.worker-command.v2" },
    "task_id": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "task_type": {
      "enum": [
        "transcription",
        "reference_matching",
        "segmentation",
        "translation",
        "calibration",
        "model_download",
        "export"
      ]
    },
    "project_id": { "type": ["string", "null"] },
    "input_schema": { "type": "string", "minLength": 1 },
    "input": { "type": "object" },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_directory", "artifact_directory"],
      "properties": {
        "project_root": { "type": ["string", "null"] },
        "work_directory": { "type": "string", "minLength": 1 },
        "artifact_directory": { "type": "string", "minLength": 1 }
      }
    },
    "credential_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "deadline_at": { "type": ["string", "null"], "format": "date-time" },
    "trace_context": { "type": "object" }
  }
}

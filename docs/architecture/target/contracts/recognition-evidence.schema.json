{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://substar.local/contracts/recognition-evidence.schema.json",
  "title": "Substar immutable recognition evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_schema_version",
    "created_at",
    "media",
    "engines",
    "language",
    "master_text",
    "chunks",
    "units",
    "request"
  ],
  "properties": {
    "schema_version": {"const": "substar.recognition-evidence.v1"},
    "source_schema_version": {"const": "substar.recognition-source.v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "media": {
      "type": "object",
      "required": ["sha256"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "duration_seconds": {"type": "number", "minimum": 0}
      }
    },
    "engines": {
      "type": "object",
      "minProperties": 1,
      "required": ["profile_id"],
      "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "language": {"type": "string"},
    "master_text": {"type": "string", "minLength": 1},
    "chunks": {"type": "array", "items": {"type": "object"}},
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "start", "end", "text"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_fingerprint",
        "profile_id",
        "requested_language",
        "prompt_sha256",
        "hotwords_sha256",
        "hotword_count",
        "provider_submission",
        "provider_response"
      ],
      "properties": {
        "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "profile_id": {"type": "string", "minLength": 1},
        "requested_language": {"type": "string", "minLength": 1},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hotwords_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hotword_count": {"type": "integer", "minimum": 0},
        "provider_submission": {"$ref": "#/$defs/artifactReference"},
        "provider_response": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/artifactReference"}
          ]
        }
      }
    }
  },
  "$defs": {
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^[^/\\\\]+$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}

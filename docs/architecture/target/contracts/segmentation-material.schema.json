{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://substar.local/contracts/segmentation-material.schema.json",
  "title": "Substar segmentation material",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_transcript", "units"],
  "properties": {
    "schema_version": {"const": "substar.segmentation-material.v1"},
    "source_transcript": {"type": "string", "minLength": 1},
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index", "start", "end", "text", "speaker_id"
        ],
        "properties": {
          "index": {"type": "integer"},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "text": {"type": "string", "minLength": 1},
          "speaker_id": {"type": ["string", "null"]}
        }
      }
    }
  }
}

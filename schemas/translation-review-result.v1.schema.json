{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://substar.local/schemas/translation-review-result.v1.schema.json",
  "title": "Translation review result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "project_id", "based_on_revision_id", "issues"],
  "properties": {
    "schema_version": {"const": "substar.translation-review-result.v1"},
    "review_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "based_on_revision_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "issue_type",
          "cue_ids",
          "source_token_ids",
          "impact",
          "confidence",
          "description",
          "evidence",
          "suggested_text",
          "recommended_action",
          "status"
        ],
        "properties": {
          "issue_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "issue_type": {
            "enum": [
              "mistranslation",
              "omission",
              "addition",
              "factual_mismatch",
              "polarity_or_logic",
              "reference_resolution",
              "terminology_consistency",
              "grammar_or_fluency",
              "subtitle_flow"
            ]
          },
          "cue_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 200}
          },
          "source_token_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 200}
          },
          "impact": {"enum": ["major", "moderate", "minor"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "description": {"type": "string", "minLength": 1, "maxLength": 2000},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 4000},
          "suggested_text": {"type": ["string", "null"], "maxLength": 10000},
          "recommended_action": {
            "enum": [
              "replace_translation",
              "retranslate_cue",
              "verify_fact",
              "inspect_context",
              "normalize_translation_occurrences",
              "manual_edit"
            ]
          },
          "status": {"enum": ["open", "accepted", "dismissed", "resolved", "stale"]}
        }
      }
    }
  }
}

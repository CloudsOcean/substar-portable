{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://substar.local/schemas/calibration-result.v1.schema.json",
  "title": "AI calibration result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "project_id",
    "based_on_revision_id",
    "actions"
  ],
  "properties": {
    "schema_version": {"const": "substar.calibration-result.v1"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "based_on_revision_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/action"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": {
          "enum": [
            "glossary",
            "reference_document",
            "document_consistency",
            "context",
            "user_instruction"
          ]
        },
        "reference": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "kind",
        "token_ids",
        "before_text",
        "after_text",
        "confidence",
        "evidence",
        "disposition",
        "affects_translation"
      ],
      "properties": {
        "action_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "kind": {
          "enum": ["set_case", "set_punctuation", "replace_token", "replace_span"]
        },
        "token_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "before_text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "after_text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "confidence": {"enum": ["high", "medium", "low"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "disposition": {"enum": ["apply", "review"]},
        "affects_translation": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "replace_token"}}},
          "then": {"properties": {"token_ids": {"maxItems": 1}}}
        },
        {
          "if": {"properties": {"kind": {"enum": ["set_case", "set_punctuation"]}}},
          "then": {"properties": {"token_ids": {"maxItems": 1}}}
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Substar Stage2 Read-only Translation Risk",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "overall_risk", "issues", "summary"],
  "properties": {
    "schema_version": {
      "const": "substar.stage2.risk.v1"
    },
    "overall_risk": {
      "enum": ["low", "medium", "high"]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cue_ids", "category", "severity", "reason"],
        "properties": {
          "cue_ids": {
            "type": "array",
            "items": {"type": "integer", "minimum": 1}
          },
          "category": {
            "enum": [
              "mistranslation",
              "omission",
              "terminology",
              "asr_source",
              "allocation",
              "factual_overclaim",
              "readability",
              "other"
            ]
          },
          "severity": {
            "enum": ["low", "medium", "high"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "string"
    }
  }
}

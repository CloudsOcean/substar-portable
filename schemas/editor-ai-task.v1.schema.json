{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://substar.local/schemas/editor-ai-task.v1.schema.json",
  "title": "Exclusive editor AI task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "project_id",
    "kind",
    "state",
    "locks_editor",
    "based_on_revision_id",
    "result_revision_id",
    "created_at",
    "started_at",
    "finished_at",
    "cancel_requested_at",
    "error"
  ],
  "properties": {
    "schema_version": {"const": "substar.editor-ai-task.v1"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "kind": {"enum": ["calibration", "translation"]},
    "state": {
      "enum": [
        "queued",
        "running",
        "cancelling",
        "succeeded",
        "succeeded_with_issues",
        "failed",
        "cancelled",
        "interrupted"
      ]
    },
    "locks_editor": {"type": "boolean"},
    "based_on_revision_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "result_revision_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "cancel_requested_at": {"type": ["string", "null"], "format": "date-time"},
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "minLength": 1, "maxLength": 200},
            "message": {"type": "string", "minLength": 1, "maxLength": 2000}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {"enum": ["queued", "running", "cancelling"]}
        }
      },
      "then": {
        "properties": {
          "locks_editor": {"const": true},
          "finished_at": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {"enum": ["succeeded", "succeeded_with_issues", "failed", "cancelled", "interrupted"]}
        }
      },
      "then": {
        "properties": {
          "locks_editor": {"const": false},
          "finished_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "cancelling"}}},
      "then": {
        "properties": {
          "cancel_requested_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://substar.local/schemas/stage1_decision.schema.json",
  "title": "Substar Stage 1.3 hierarchical blind decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "groups", "final_draft"],
  "properties": {
    "schema_version": {"const": "substar.stage1.decision.v2"},
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group_id", "selected_candidate_id", "cues", "scores",
          "weakest_cue_check", "rejected"
        ],
        "properties": {
          "group_id": {"type": "string", "pattern": "^g[0-9]{4,}$"},
          "selected_candidate_id": {"type": "string", "minLength": 1},
          "cues": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "protection_integrity", "language_chunks", "meaning_rhetoric",
              "alignment_timing", "company_style", "visual_balance"
            ],
            "properties": {
              "protection_integrity": {"type": "number", "minimum": 0, "maximum": 35},
              "language_chunks": {"type": "number", "minimum": 0, "maximum": 20},
              "meaning_rhetoric": {"type": "number", "minimum": 0, "maximum": 20},
              "alignment_timing": {"type": "number", "minimum": 0, "maximum": 15},
              "company_style": {"type": "number", "minimum": 0, "maximum": 5},
              "visual_balance": {"type": "number", "minimum": 0, "maximum": 5}
            }
          },
          "weakest_cue_check": {"type": "string", "minLength": 1},
          "rejected": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate_id", "reason"],
              "properties": {
                "candidate_id": {"type": "string"},
                "reason": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "final_draft": {"type": "string", "minLength": 1}
  }
}

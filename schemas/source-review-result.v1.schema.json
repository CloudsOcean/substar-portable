{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://substar.local/schemas/source-review-result.v1.schema.json",
  "title": "Source review result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "project_id", "based_on_revision_id", "issues"],
  "properties": {
    "schema_version": {"const": "substar.source-review-result.v1"},
    "review_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "based_on_revision_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "issue_type",
          "cue_ids",
          "token_ids",
          "impact",
          "confidence",
          "description",
          "evidence",
          "suggested_text",
          "recommended_action",
          "status"
        ],
        "properties": {
          "issue_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "issue_type": {
            "enum": [
              "suspected_misrecognition",
              "suspected_omission",
              "suspected_repetition",
              "named_entity_or_term",
              "number_or_unit",
              "context_incoherence",
              "source_consistency"
            ]
          },
          "cue_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 200}
          },
          "token_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 200}
          },
          "impact": {"enum": ["major", "moderate", "minor"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "description": {"type": "string", "minLength": 1, "maxLength": 2000},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 4000},
          "suggested_text": {"type": ["string", "null"], "maxLength": 4000},
          "recommended_action": {
            "enum": [
              "inspect_audio",
              "replace_source",
              "verify_entity",
              "verify_number",
              "normalize_source_occurrences",
              "manual_edit"
            ]
          },
          "status": {"enum": ["open", "accepted", "dismissed", "resolved", "stale"]}
        }
      }
    }
  }
}
